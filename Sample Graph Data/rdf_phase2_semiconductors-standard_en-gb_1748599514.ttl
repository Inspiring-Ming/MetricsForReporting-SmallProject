# Core Entities (with metadata corrections)
esg:Semiconductors a esg:Industry ;
    rdfs:label "Semiconductors" ;
    rdfs:comment "Industry covered by SASB Semiconductors standards" .

esg:SASBSemiconductors a esg:ReportingFramework ;
    rdfs:label "SASB Semiconductors" ;
    rdfs:comment "Reporting framework with concept alignments to external ontologies" .

