# ESG Knowledge Graph Platform - Environment Configuration Template
# Copy this file to .env and customize the values for your environment

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
APP_NAME=esg-kg-platform

# =============================================================================
# PUBLIC API (Write Service) - TypeScript/Fastify
# =============================================================================
PUBLIC_API_PORT=3001
PUBLIC_API_HOST=0.0.0.0
PUBLIC_API_BASE_URL=http://localhost:3001

# Request handling
PUBLIC_API_REQUEST_TIMEOUT=30000
PUBLIC_API_BODY_LIMIT=10485760
PUBLIC_API_RATE_LIMIT_MAX=100
PUBLIC_API_RATE_LIMIT_WINDOW=900000

# =============================================================================
# INTERNAL API (Read Service) - Go
# =============================================================================
INTERNAL_API_PORT=3002
INTERNAL_API_HOST=0.0.0.0
INTERNAL_API_BASE_URL=http://localhost:3002

# Request handling
INTERNAL_API_REQUEST_TIMEOUT=30s
INTERNAL_API_READ_TIMEOUT=10s
INTERNAL_API_WRITE_TIMEOUT=10s

# =============================================================================
# GRAPHDB CONFIGURATION
# =============================================================================
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=esg-repo
GRAPHDB_USERNAME=admin
GRAPHDB_PASSWORD=admin
GRAPHDB_TIMEOUT=30s
GRAPHDB_MAX_CONNECTIONS=10

# SPARQL endpoints
GRAPHDB_SPARQL_ENDPOINT=http://localhost:7200/repositories/esg-repo
GRAPHDB_SPARQL_UPDATE_ENDPOINT=http://localhost:7200/repositories/esg-repo/statements

# =============================================================================
# REDIS CONFIGURATION (Optional caching)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# Cache TTL settings (in seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# 认证设置 - 本地开发环境禁用
AUTH_ENABLED=false
DEV_MODE=true

# JWT设置 (预留，未来使用)
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_IN=24h

# API Keys (预留，未来服务间通信使用)
# API_KEY_PUBLIC=public-api-key-change-this
# API_KEY_INTERNAL=internal-api-key-change-this

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# =============================================================================
# SHACL VALIDATION
# =============================================================================
SHACL_VALIDATION_ENABLED=true
SHACL_SHAPES_PATH=./packages/shacl/rules
SHACL_VALIDATION_TIMEOUT=10s

# =============================================================================
# DATA INGESTION
# =============================================================================
INGEST_BATCH_SIZE=1000
INGEST_MAX_FILE_SIZE=50MB
INGEST_ALLOWED_FORMATS=json,ttl,nt,rdf

# Named graph settings
DEFAULT_GRAPH_BASE_URI=https://esg.example.com/graph/
PROVENANCE_GRAPH_URI=https://esg.example.com/graph/provenance

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s

# Request tracing
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# DOCKER & INFRASTRUCTURE
# =============================================================================
COMPOSE_PROJECT_NAME=esg-kg-platform

# GraphDB Docker settings
GRAPHDB_DOCKER_IMAGE=ontotext/graphdb:10.0.0
GRAPHDB_DOCKER_PORT=7200
GRAPHDB_DOCKER_MEMORY=2g

# Redis Docker settings
REDIS_DOCKER_IMAGE=redis:7-alpine
REDIS_DOCKER_PORT=6379

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Hot reload settings
WATCH_FILES=true
WATCH_EXTENSIONS=ts,js,go

# Debug settings
DEBUG_ENABLED=true
DEBUG_PORT=9229

# Test database (separate from main)
TEST_GRAPHDB_REPOSITORY=esg-repo-test
TEST_REDIS_DB=1

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify for production deployment

# SSL/TLS Configuration
# SSL_ENABLED=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# External service URLs (production)
# GRAPHDB_URL=https://graphdb.production.example.com
# REDIS_URL=redis://redis.production.example.com:6379

# Security hardening
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STRICT=true
# SECURITY_HEADERS_ENABLED=true

# Backup configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=esg-kg-backups