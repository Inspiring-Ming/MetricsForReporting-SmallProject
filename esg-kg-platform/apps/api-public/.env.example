# ESG Public API Environment Configuration

# Server Configuration
PORT=3001
HOST=localhost
NODE_ENV=development

# API Configuration
API_PREFIX=/public/v1
CORS_ENABLED=true
COMPRESSION_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# GraphDB Configuration
GRAPHDB_URL=http://localhost:7200
GRAPHDB_REPOSITORY=esg-repo
GRAPHDB_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
TRUST_PROXY=false
HELMET_ENABLED=true

# Request Configuration
STRICT_VALIDATION=true
MAX_REQUEST_BODY_SIZE=10mb

# Computation Service Configuration
COMPUTATION_SERVICE_URL=http://localhost:3003
COMPUTATION_TIMEOUT=60000
