{
  "name": "@esg-platform/api-public",
  "version": "1.0.0",
  "description": "ESG Platform Public API - Express-based Write Service for data ingestion and validation",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node src/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@esg-platform/dto": "workspace:*",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.2",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "esg",
    "express",
    "api",
    "typescript",
    "knowledge-graph",
    "rdf"
  ],
  "author": "ESG Platform Team",
  "license": "MIT"
}
