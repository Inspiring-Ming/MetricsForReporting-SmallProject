{
  "name": "esg-kg-backend",
  "version": "1.0.0",
  "description": "ESG Knowledge Graph Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "generate:docs": "pnpm tsoa:spec && pnpm tsoa:routes"
  },
  "keywords": [
    "express",
    "typescript",
    "esg",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.19.21",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "29.2.5",
    "ts-node-dev": "^2.0.0"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
