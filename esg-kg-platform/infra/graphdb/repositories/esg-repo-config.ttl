# ESG Knowledge Graph Repository Configuration
# This configuration file defines the GraphDB repository for ESG data management
# with SHACL validation, reasoning, and semantic indexing enabled

@prefix rep: <http://www.openrdf.org/config/repository#> .
@prefix sr: <http://www.openrdf.org/config/repository/sail#> .
@prefix sail: <http://www.openrdf.org/config/sail#> .
@prefix graphdb: <http://www.ontotext.com/config/graphdb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

[] a rep:Repository ;
    rep:repositoryID "esg-repo" ;
    rdfs:label "ESG Knowledge Graph Repository" ;
    rdfs:comment """
        Repository for ESG (Environmental, Social, Governance) data management.
        
        Features enabled:
        - SHACL validation for data quality assurance
        - OWL reasoning for semantic inference
        - Full-text search indexing
        - Named graph support for provenance tracking
        - Time-based versioning support
        
        Ontologies supported:
        - QUDT for units and quantities
        - OWL-Time for temporal modeling
        - PROV-O for provenance tracking
        - SHACL for data validation constraints
    """ ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "graphdb:Sail" ;
            
            # Repository ID and basic settings
            graphdb:repository-id "esg-repo" ;
            graphdb:repository-type "file-repository" ;
            graphdb:entity-index-size "10000000" ;
            graphdb:entity-id-size "32" ;
            # NOTE: Removed imports/defaultNS to avoid mismatch issues
            # Data will be loaded via REST API instead
            
            # SHACL Validation - ENABLED for ESG data quality
            graphdb:shaclEnabled "true" ;
            graphdb:shaclValidationEnabled "true" ;
            graphdb:shaclParallelValidation "true" ;
            graphdb:shaclLogValidationPlans "false" ;
            graphdb:shaclLogValidationViolations "true" ;
            graphdb:shaclPerformanceLogging "false" ;
            graphdb:shaclIgnoreImports "false" ;
            
            # OWL Reasoning - Basic reasoning for ESG ontologies
            graphdb:owlhorst-optimistic-optimization "true" ;
            graphdb:enable-context-index "true" ;
            graphdb:enablePredicateList "true" ;
            graphdb:enable-literal-index "true" ;
            graphdb:check-for-inconsistencies "false" ;
            graphdb:disable-sameAs "true" ;
            graphdb:query-timeout "0" ;
            graphdb:query-limit-results "0" ;
            graphdb:throw-QueryEvaluationException-on-timeout "false" ;
            graphdb:read-only "false" ;
            
            # Storage and Performance Settings
            graphdb:storage-folder "storage" ;
            graphdb:enable-optimization "true" ;
            graphdb:in-memory-literal-properties "true" ;
            graphdb:enable-literal-index "true" ;
            
            # Full-Text Search for ESG metrics and descriptions
            graphdb:ftsEnabled "true" ;
            graphdb:ftsIndexPolicy "never" ;
            graphdb:ftsLiteralsOnly "true" ;
            
            # Geo-spatial Support (useful for ESG location data)
            graphdb:enableGeoSPARQL "true" ;
            
            # Transaction and Concurrency Settings
            graphdb:entity-pool-implementation "transactional" ;
            graphdb:base-URL "https://kg.example.org/" ;
            
            # Backup and Recovery
            graphdb:repository.backup.compression "gzip" ;
            
            # ESG-Specific Index Configurations
            # Enable efficient querying for temporal and metric data
            graphdb:enablePredicateList "true" ;
            graphdb:predicate-memory-cache-size "50000" ;
            
            # Named Graph Support for ESG data versioning
            graphdb:enable-context-index "true" ;
            graphdb:context-index-policy "default" ;
            
            # Memory and Performance Tuning for ESG workloads
            graphdb:ruleset "empty" ;  # We'll use SHACL instead of built-in rules
            graphdb:storage-folder "storage" ;
            graphdb:entity-index-size "10000000" ;
            
            # Security Settings
            graphdb:read-only "false" ;
        ]
    ] .

# ESG-Specific Configuration Notes:
#
# 1. SHACL Validation: Enabled to ensure ESG data quality
#    - Validates metric units, temporal constraints, and required fields
#    - Supports QUDT unit validation and OWL-Time temporal constraints
#
# 2. Named Graphs: Used for ESG data provenance and versioning
#    - Pattern: urn:g/{yyyy-mm-dd}/ingest-{batchId}
#    - Enables temporal queries and audit trails
#
# 3. Base IRI: https://kg.example.org/ 
#    - All ESG entities use this base for consistent identification
#    - Metrics: https://kg.example.org/esg/metric/{framework}/{code}
#    - Entities: https://kg.example.org/entity/{namespace}/{id}
#
# 4. Performance Optimizations:
#    - Entity index sized for large ESG datasets
#    - Literal indexing for metric values and descriptions
#    - Context indexing for efficient named graph queries
#
# 5. Supported ESG Ontologies:
#    - QUDT: Units and quantities (e.g., kg CO2-eq, MWh, USD)
#    - OWL-Time: Temporal intervals and instants
#    - PROV-O: Data provenance and audit trails
#    - SHACL: Data validation constraints for ESG metrics