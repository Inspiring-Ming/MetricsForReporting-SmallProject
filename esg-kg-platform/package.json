{
  "name": "esg-kg-platform",
  "version": "0.1.0",
  "description": "ESG Knowledge Graph Platform - A comprehensive solution for ESG metrics ingestion, validation, and reporting",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "echo 'Use make dev-public or make dev-internal to start services'",
    "build": "pnpm --recursive --filter './apps/*' --filter './packages/*' build",
    "test": "pnpm --recursive --filter './apps/*' --filter './packages/*' test",
    "test:unit": "pnpm --recursive --filter './apps/*' --filter './packages/*' test:unit",
    "test:integration": "pnpm --recursive --filter './apps/*' test:integration",
    "lint": "pnpm --recursive --filter './apps/*' --filter './packages/*' lint",
    "lint:fix": "pnpm --recursive --filter './apps/*' --filter './packages/*' lint:fix",
    "format": "pnpm --recursive --filter './apps/*' --filter './packages/*' format",
    "format:check": "pnpm --recursive --filter './apps/*' --filter './packages/*' format:check",
    "typecheck": "pnpm --recursive --filter './apps/*' --filter './packages/*' typecheck",
    "clean": "pnpm --recursive --filter './apps/*' --filter './packages/*' clean && rm -rf node_modules",
    "generate": "pnpm --recursive --filter './packages/dto' generate",
    "up": "make up",
    "down": "make down",
    "setup": "make setup"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "esg",
    "knowledge-graph",
    "rdf",
    "sparql",
    "graphdb",
    "typescript",
    "go",
    "fastify",
    "sustainability",
    "reporting"
  ],
  "author": "ESG Platform Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inspiring-Ming/MetricsForReporting-SmallProject.git"
  },
  "bugs": {
    "url": "https://github.com/Inspiring-Ming/MetricsForReporting-SmallProject/issues"
  },
  "homepage": "https://github.com/Inspiring-Ming/MetricsForReporting-SmallProject#readme"
}