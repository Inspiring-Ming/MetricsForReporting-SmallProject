{
  "name": "@esg-platform/shacl",
  "version": "1.0.0", 
  "description": "SHACL (Shapes Constraint Language) rules for ESG Knowledge Graph Platform data validation",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "rules/",
    "src/",
    "*.ttl"
  ],
  "scripts": {
    "validate": "shacl validate --shapes rules/ --data examples/",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test src/**/*.test.js",
    "lint:ttl": "riot --validate rules/*.ttl",
    "docs": "markdown-toc -i README.md"
  },
  "keywords": [
    "shacl",
    "rdf", 
    "validation",
    "esg",
    "knowledge-graph",
    "graphdb",
    "qudt",
    "owl-time"
  ],
  "author": "ESG Platform Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "markdown-toc": "^1.2.0"
  },
  "dependencies": {
    "rdflib": "^2.2.0"
  },
  "peerDependencies": {
    "@esg-platform/dto": "^1.0.0"
  }
}
