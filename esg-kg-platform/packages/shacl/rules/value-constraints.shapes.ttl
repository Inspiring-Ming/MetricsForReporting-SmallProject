@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix esg:   <https://esg.platform/ontology/> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix unit:  <http://qudt.org/vocab/unit/> .
@prefix qkind: <http://qudt.org/vocab/quantitykind/> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

######################################################################
# Unit 列表/命名空间约束（在 Core 已做前缀校验，这里可做白名单或提示）
######################################################################

esg:ApprovedUnitListConstraint
  a sh:NodeShape ;
  sh:targetClass esg:Metric ;
  rdfs:label "Approved unit list (optional tightening)" ;
  rdfs:comment "Optional: restrict to a curated subset of QUDT units. Expand as needed." ;
  sh:sparql [
    sh:severity sh:Warning ;
    sh:message "unitIri is unusual (not in curated list) — verify unit correctness" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:unitIri ?u .
        FILTER NOT EXISTS {
          VALUES ?u {
            # --- Currency ---
            unit:USD unit:EUR unit:GBP unit:JPY unit:CNY
            # --- Percentage / Ratio ---
            unit:PERCENT unit:FRACTION
            # --- Mass ---
            unit:GM unit:KiloGM unit:Tonne
            # --- Mass rate (examples) ---
            unit:KiloGM-PER-YR unit:Tonne-PER-YR
            # --- Energy / Electricity ---
            unit:J unit:KiloJ unit:MegaJ unit:W-HR unit:KiloW-HR unit:MegaW-HR
            # --- Volume ---
            unit:L unit:MilliL unit:M3
            # --- Count / Unitless ---
            unit:NUM unit:UNITLESS
            # --- Time ---
            unit:YR unit:MO unit:WK unit:DAY unit:HR unit:MIN unit:SEC
          }
        }
      }
    """ ;
  ] .

######################################################################
# 时间约束（不得未来，合理历史下限）
######################################################################

esg:TemporalConstraint
  a sh:NodeShape ;
  sh:targetClass esg:Metric ;
  rdfs:label "Temporal constraints for asOf" ;

  # 不能晚于当前时间
  sh:sparql [
    sh:message "asOf cannot be in the future" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:asOf ?asOf .
        BIND (NOW() AS ?now)
        FILTER (?asOf > ?now)
      }
    """ ;
  ] ;

  # 历史下限（可按业务调整）
  sh:sparql [
    sh:message "asOf must be after 1900-01-01T00:00:00Z" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:asOf ?asOf .
        FILTER (?asOf < "1900-01-01T00:00:00Z"^^xsd:dateTime)
      }
    """ ;
  ] .

######################################################################
# 百分比/分数值域
######################################################################

esg:PercentageAndFractionRanges
  a sh:NodeShape ;
  sh:targetClass esg:Metric ;
  rdfs:label "Value ranges for percentage/fraction" ;

  # %: 0..100
  sh:sparql [
    sh:message "When unit = PERCENT, value must be between 0 and 100" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:unitIri unit:PERCENT ;
              esg:value ?v .
        FILTER (?v < 0 || ?v > 100)
      }
    """ ;
  ] ;

  # fraction: 0..1
  sh:sparql [
    sh:message "When unit = FRACTION, value must be between 0 and 1" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:unitIri unit:FRACTION ;
              esg:value ?v .
        FILTER (?v < 0 || ?v > 1)
      }
    """ ;
  ] .

######################################################################
# 环境类指标的单位提示（启发式，设为 Warning）
######################################################################

esg:EnvironmentalEmissionsUnitHint
  a sh:NodeShape ;
  sh:targetClass esg:Metric ;
  rdfs:label "Heuristic hint for emissions-related metrics" ;
  sh:sparql [
    sh:severity sh:Warning ;
    sh:message "Emissions-like metrics typically use mass or mass-rate units" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:code ?code ;
              esg:unitIri ?u .
        FILTER (
          CONTAINS(LCASE(STR(?code)), "emission") ||
          CONTAINS(LCASE(STR(?code)), "ghg") ||
          CONTAINS(LCASE(STR(?code)), "co2") ||
          CONTAINS(LCASE(STR(?code)), "carbon")
        )
        FILTER (?u NOT IN (
          unit:GM, unit:KiloGM, unit:Tonne,
          unit:KiloGM-PER-YR, unit:Tonne-PER-YR
        ))
      }
    """ ;
  ] .

######################################################################
# SASB 财务类单位提示（启发式，设为 Warning）
######################################################################

esg:SASBFinancialCurrencyUnitHint
  a sh:NodeShape ;
  sh:targetClass esg:Metric ;
  rdfs:label "Heuristic hint for SASB financial metrics to use currency units" ;
  sh:sparql [
    sh:severity sh:Warning ;
    sh:message "SASB financial codes often expect currency units (USD/EUR/...)" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:framework "SASB" ;
              esg:code ?code ;
              esg:unitIri ?u .
        # 仅示例性地将 410a / 420a 视为财务相关，按需扩充
        FILTER ( CONTAINS(?code, "410a") || CONTAINS(?code, "420a") )
        FILTER (?u NOT IN ( unit:USD, unit:EUR, unit:GBP, unit:JPY, unit:CNY ))
      }
    """ ;
  ] .

######################################################################
# 溯源（来源）提示（弱约束）
######################################################################

esg:ProvenanceHints
  a sh:NodeShape ;
  sh:targetClass esg:Metric ;
  rdfs:label "Provenance textual hints" ;
  sh:sparql [
    sh:severity sh:Info ;
    sh:message "source should mention a document type (Report/Annual/Sustainability/...)" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:source ?s .
        FILTER ( !REGEX(?s, "(Report|report|Annual|annual|Sustainability|sustainability|Filing|filing|Assessment|assessment)") )
      }
    """ ;
  ] ;
  sh:sparql [
    sh:severity sh:Info ;
    sh:message "source should include a year like 20XX" ;
    sh:select """
      SELECT $this WHERE {
        $this esg:source ?s .
        FILTER ( !REGEX(?s, "20[0-9]{2}") )
      }
    """ ;
  ] .
