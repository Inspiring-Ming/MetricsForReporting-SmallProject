@prefix esg: <http://esg-kg.org/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Industry (corrected during RDF generation)
esg:CommercialBanks a esg:Industry ;
    rdfs:label "Commercial Banks" ;
    rdfs:comment "Industry covered by SASB Commercial Banks standards and regulations" .

# Reporting Framework (corrected during RDF generation)
esg:SASBCommercialBanks a esg:ReportingFramework ;
    rdfs:label "SASB Commercial Banks" ;
    rdfs:comment "Sustainability Accounting Standards Board framework for ESG reporting" .

# Categories
esg:DataSecurity a esg:Category ;
    rdfs:label "Data Security" ;
    rdfs:comment "Data Security requirements and disclosures under SASB Commercial Banks" .

esg:FinancialInclusionAndCapacityBuilding a esg:Category ;
    rdfs:label "Financial Inclusion & Capacity Building" ;
    rdfs:comment "Financial Inclusion & Capacity Building requirements and disclosures under SASB Commercial Banks" .

esg:IncorporationofEnvironmentalSocialandGovernanceFactorsinCreditAnalysis a esg:Category ;
    rdfs:label "Incorporation of Environmental, Social, and Governance Factors in Credit Analysis" ;
    rdfs:comment "Climate governance structures, responsibilities, and oversight processes" .

esg:FinancedEmissions a esg:Category ;
    rdfs:label "Financed Emissions" ;
    rdfs:comment "Financed Emissions requirements and disclosures under SASB Commercial Banks" .

esg:BusinessEthics a esg:Category ;
    rdfs:label "Business Ethics" ;
    rdfs:comment "Business Ethics requirements and disclosures under SASB Commercial Banks" .

esg:SystemicRiskManagement a esg:Category ;
    rdfs:label "Systemic Risk Management" ;
    rdfs:comment "Climate risk identification, assessment, prioritization, and monitoring processes" .

# Metrics
esg:NumberDataBreaches a esg:Metric ;
    rdfs:label "Number Data Breaches" ;
    rdfs:comment "Number of data breaches" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:PercentagePersonalDataBreaches a esg:Metric ;
    rdfs:label "Percentage Personal Data Breaches" ;
    rdfs:comment "Percentage that are personal data breaches" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" ;
    esg:isCalculatedBy esg:PersonalDataBreachRate .

esg:AccountHoldersAffected a esg:Metric ;
    rdfs:label "Account Holders Affected" ;
    rdfs:comment "Number of account holders affected" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:DataSecurityRiskApproach a esg:Metric ;
    rdfs:label "Data Security Risk Approach" ;
    rdfs:comment "Description of approach to identifying and addressing data security risks" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Discussion" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:SmallBusinessLoanCount a esg:Metric ;
    rdfs:label "Small Business Loan Count" ;
    rdfs:comment "Number of loans outstanding that qualify for programmes designed to promote small business and community development" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:SmallBusinessLoanAmount a esg:Metric ;
    rdfs:label "Small Business Loan Amount" ;
    rdfs:comment "Amount of loans outstanding that qualify for programmes designed to promote small business and community development" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:PastDueLoanCount a esg:Metric ;
    rdfs:label "Past Due Loan Count" ;
    rdfs:comment "Number of past due and nonaccrual loans or loans subject to forbearance that qualify for programmes designed to promote small business and community development" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:PastDueLoanAmount a esg:Metric ;
    rdfs:label "Past Due Loan Amount" ;
    rdfs:comment "Amount of past due and nonaccrual loans or loans subject to forbearance that qualify for programmes designed to promote small business and community development" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:NoCostCheckingAccounts a esg:Metric ;
    rdfs:label "No Cost Checking Accounts" ;
    rdfs:comment "Number of no-cost retail checking accounts provided to previously unbanked or underbanked customers" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:FinancialLiteracyParticipants a esg:Metric ;
    rdfs:label "Financial Literacy Participants" ;
    rdfs:comment "Number of participants in financial literacy initiatives for unbanked, underbanked, or underserved customers" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:ESGCreditAnalysisApproach a esg:Metric ;
    rdfs:label "ESG Credit Analysis Approach" ;
    rdfs:comment "Description of approach to incorporation of environmental, social and governance (ESG) factors in credit analysis" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Discussion" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:Scope1FinancedEmissions a esg:Metric ;
    rdfs:label "Scope 1 Financed Emissions" ;
    rdfs:comment "Absolute gross financed emissions, disaggregated by Scope 1" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:Scope2FinancedEmissions a esg:Metric ;
    rdfs:label "Scope 2 Financed Emissions" ;
    rdfs:comment "Absolute gross financed emissions, disaggregated by Scope 2" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:Scope3FinancedEmissions a esg:Metric ;
    rdfs:label "Scope 3 Financed Emissions" ;
    rdfs:comment "Absolute gross financed emissions, disaggregated by Scope 3" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:GrossExposureByIndustry a esg:Metric ;
    rdfs:label "Gross Exposure By Industry" ;
    rdfs:comment "Gross exposure for each industry by asset class" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:FinancedEmissionsCoveragePercentage a esg:Metric ;
    rdfs:label "Financed Emissions Coverage Percentage" ;
    rdfs:comment "Percentage of gross exposure included in the financed emissions calculation" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" ;
    esg:isCalculatedBy esg:FinancedEmissionsCoverageRate .

esg:FinancedEmissionsMethodology a esg:Metric ;
    rdfs:label "Financed Emissions Methodology" ;
    rdfs:comment "Description of the methodology used to calculate financed emissions" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Discussion" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:LegalProceedingsMonetaryLosses a esg:Metric ;
    rdfs:label "Legal Proceedings Monetary Losses" ;
    rdfs:comment "Total amount of monetary losses as a result of legal proceedings associated with fraud, insider trading, antitrust, anti-competitive behaviour, market manipulation, malpractice, or other related financial industry laws or regulations" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:WhistleblowerPoliciesDescription a esg:Metric ;
    rdfs:label "Whistleblower Policies Description" ;
    rdfs:comment "Description of whistleblower policies and procedures" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Discussion" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:GSIBScoreByCategory a esg:Metric ;
    rdfs:label "G-SIB Score By Category" ;
    rdfs:comment "Global Systemically Important Bank (G-SIB) score, by category" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Quantitative" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

esg:StressTestIntegrationApproach a esg:Metric ;
    rdfs:label "Stress Test Integration Approach" ;
    rdfs:comment "Description of approach to integrate results of mandatory and voluntary stress tests into capital adequacy planning, long-term corporate strategy, and other business activities" ;
    esg:hasCode "n/a" ;
    esg:hasUnit "n/a" ;
    esg:hasMetricType "Discussion" ;
    esg:hasIndustry "Commercial Banks" ;
    esg:hasReportingFramework "SASB Commercial Banks" .

# Models
esg:PersonalDataBreachRate a esg:Model ;
    rdfs:label "Personal Data Breach Rate" ;
    rdfs:comment "Percentage of total data breaches that involve personal data" .

esg:FinancedEmissionsCoverageRate a esg:Model ;
    rdfs:label "Financed Emissions Coverage Rate" ;
    rdfs:comment "Percentage of total gross exposure included in financed emissions calculation" .

# Relationships
esg:SASBCommercialBanks esg:include esg:DataSecurity .
esg:SASBCommercialBanks esg:include esg:FinancialInclusionAndCapacityBuilding .
esg:SASBCommercialBanks esg:include esg:IncorporationofEnvironmentalSocialandGovernanceFactorsinCreditAnalysis .
esg:SASBCommercialBanks esg:include esg:FinancedEmissions .
esg:SASBCommercialBanks esg:include esg:BusinessEthics .
esg:SASBCommercialBanks esg:include esg:SystemicRiskManagement .
esg:DataSecurity esg:consistOf esg:NumberDataBreaches .
esg:DataSecurity esg:consistOf esg:PercentagePersonalDataBreaches .
esg:DataSecurity esg:consistOf esg:AccountHoldersAffected .
esg:DataSecurity esg:consistOf esg:DataSecurityRiskApproach .
esg:FinancialInclusionAndCapacityBuilding esg:consistOf esg:SmallBusinessLoanCount .
esg:FinancialInclusionAndCapacityBuilding esg:consistOf esg:SmallBusinessLoanAmount .
esg:FinancialInclusionAndCapacityBuilding esg:consistOf esg:PastDueLoanCount .
esg:FinancialInclusionAndCapacityBuilding esg:consistOf esg:PastDueLoanAmount .
esg:FinancialInclusionAndCapacityBuilding esg:consistOf esg:NoCostCheckingAccounts .
esg:FinancialInclusionAndCapacityBuilding esg:consistOf esg:FinancialLiteracyParticipants .
esg:IncorporationofEnvironmentalSocialandGovernanceFactorsinCreditAnalysis esg:consistOf esg:ESGCreditAnalysisApproach .
esg:FinancedEmissions esg:consistOf esg:Scope1FinancedEmissions .
esg:FinancedEmissions esg:consistOf esg:Scope2FinancedEmissions .
esg:FinancedEmissions esg:consistOf esg:Scope3FinancedEmissions .
esg:FinancedEmissions esg:consistOf esg:GrossExposureByIndustry .
esg:FinancedEmissions esg:consistOf esg:FinancedEmissionsCoveragePercentage .
esg:FinancedEmissions esg:consistOf esg:FinancedEmissionsMethodology .
esg:BusinessEthics esg:consistOf esg:LegalProceedingsMonetaryLosses .
esg:BusinessEthics esg:consistOf esg:WhistleblowerPoliciesDescription .
esg:SystemicRiskManagement esg:consistOf esg:GSIBScoreByCategory .
esg:SystemicRiskManagement esg:consistOf esg:StressTestIntegrationApproach .
