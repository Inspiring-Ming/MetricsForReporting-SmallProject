# Core Entities (with metadata corrections)
esg:CommercialBanks a esg:Industry ;
    rdfs:label "Commercial Banks" ;
    rdfs:comment "Industry covered by SASB Commercial Banks standards" .

esg:SASBCommercialBanks a esg:ReportingFramework ;
    rdfs:label "SASB Commercial Banks" ;
    rdfs:comment "Reporting framework with concept alignments to external ontologies" .

# Aligned Concepts (Eurofidai Mappings)
esg:FinancedEmissionsScope3 a esg:Metric ;
    rdfs:label "Financed Emissions Scope 3" ;
    rdfs:comment "Regulatory metric aligned with Eurofidai dataset" ;
    esg:alignedWithEurofidai esg:CO2INDIRECTSCOPE3 ;
    esg:alignmentConfidence 0.75 ;
    esg:unitCompatible true .

